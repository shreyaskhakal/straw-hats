# Mandate Gateway — Environment Configuration (Template)
# Copy to .env for local development with custom settings.

# Server Port
PORT=3001

# Node Environment ('development' | 'production' | 'test')
NODE_ENV=development

# Allowed CORS Origins (comma-separated list of origins)
CORS_ORIGINS=http://localhost:5173,http://localhost:3001,http://127.0.0.1:5173

# Frontend Public Base URL (optional for absolute redirects)
FRONTEND_URL=http://localhost:5173

# Gateway Session Secret (minimum 32 characters in production)
SESSION_SECRET=dev-secret-do-not-use-in-production-32charsmin!

# PayPal Sandbox Configuration (Optional - Gateway operates in Mock Sandbox mode if omitted)
PAYPAL_MODE=sandbox
PAYPAL_CLIENT_ID=sb-client-id-placeholder
PAYPAL_CLIENT_SECRET=sb-client-secret-placeholder
PAYPAL_WEBHOOK_ID=webhook-listener-id-placeholder

# Rate Limiting Configuration
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=300
AUTH_RATE_LIMIT_MAX=20
