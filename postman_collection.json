          "response": [
            {
              "name": "Parsed Brief",
              "status": "OK",
              "code": 200,
              "header": [{ "key": "Content-Type", "value": "application/json" }],
              "body": "{\n  \"success\": true,\n  \"structuredBrief\": {\n    \"category\": \"electronics\",\n    \"subCategory\": \"computer_peripherals\",\n    \"maxPriceINR\": 3000,\n    \"mustHaves\": [\"ergonomic\", \"wireless\", \"bluetooth\"],\n    \"suggestedQuery\": \"ergonomic wireless bluetooth mouse\"\n  }\n}"
