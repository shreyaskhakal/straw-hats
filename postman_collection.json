            "url": {
              "raw": "{{baseUrl}}/agent/parse-brief",
              "host": ["{{baseUrl}}"],
              "path": ["agent", "parse-brief"]
            },
            "description": "Transforms unstructured natural language shopping intent into structured product constraints."
